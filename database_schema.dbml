// OJT360 Database Schema
// Paste this into dbdiagram.io or similar tools

// ===== AUTHENTICATION & USER MANAGEMENT =====

Table users {
  id bigint [pk, increment]
  name varchar(255) [not null]
  email varchar(255) [unique, not null]
  password varchar(255) [not null]
  role enum('admin','coordinator','supervisor','intern') [not null]
  email_verified_at timestamp
  must_change_password boolean [default: false]
  remember_token varchar(100)
  created_at timestamp
  updated_at timestamp
}

Table student_profiles {
  id bigint [pk, increment]
  user_id bigint [unique, not null, ref: - users.id]
  student_id varchar(255) [unique, not null]
  program_id bigint [ref: > programs.id]
  supervisor_id bigint [ref: > users.id]
  course varchar(255)
  year_level varchar(50)
  section varchar(50)
  course_section_code varchar(100)
  department varchar(255)
  phone varchar(20)
  address text
  ojt_status enum('pending','active','completed') [default: 'pending']
  required_hours integer
  completed_hours integer [default: 0]
  preplacement_complete boolean [default: false]
  profile_image varchar(255)
  created_at timestamp
  updated_at timestamp
}

Table coordinator_profiles {
  id bigint [pk, increment]
  user_id bigint [unique, not null, ref: - users.id]
  department_id bigint [ref: > departments.id]
  program_id bigint [ref: > programs.id]
  department varchar(255)
  employee_id varchar(255) [unique]
  phone varchar(20)
  status varchar(50) [default: 'active']
  profile_image varchar(255)
  created_at timestamp
  updated_at timestamp
}

Table supervisor_profiles {
  id bigint [pk, increment]
  user_id bigint [unique, not null, ref: - users.id]
  company_id bigint [ref: > companies.id]
  position varchar(255)
  phone varchar(20)
  status varchar(50) [default: 'pending']
  profile_image varchar(255)
  created_at timestamp
  updated_at timestamp
}

// ===== ORGANIZATIONAL STRUCTURE =====

Table departments {
  id bigint [pk, increment]
  name varchar(255) [unique, not null]
  code varchar(50) [unique]
  created_at timestamp
  updated_at timestamp
}

Table programs {
  id bigint [pk, increment]
  department_id bigint [not null, ref: > departments.id]
  name varchar(255) [not null]
  code varchar(50)
  required_hours integer
  created_at timestamp
  updated_at timestamp
}

Table companies {
  id bigint [pk, increment]
  name varchar(255) [not null]
  address text
  department varchar(255)
  contact_person varchar(255)
  contact_email varchar(255)
  contact_phone varchar(20)
  status varchar(50) [default: 'active']
  created_at timestamp
  updated_at timestamp
}

// ===== ENROLLMENT & ACTIVATION =====

Table enrollment_whitelists {
  id bigint [pk, increment]
  student_id varchar(255) [unique, not null]
  name varchar(255) [not null]
  email varchar(255) [not null]
  program_id bigint [ref: > programs.id]
  department_id bigint [ref: > departments.id]
  contact_number varchar(20)
  status varchar(50) [default: 'pending']
  notes text
  created_at timestamp
  updated_at timestamp
}

Table student_verifications {
  id bigint [pk, increment]
  student_id varchar(255) [not null]
  token varchar(255) [unique, not null]
  expires_at timestamp [not null]
  created_at timestamp
}

Table coordinator_invitations {
  id bigint [pk, increment]
  email varchar(255) [not null]
  department_id bigint [ref: > departments.id]
  program_id bigint [ref: > programs.id]
  token varchar(255) [unique, not null]
  expires_at timestamp [not null]
  created_at timestamp
}

Table supervisor_registrations {
  id bigint [pk, increment]
  email varchar(255) [not null]
  token varchar(255) [unique, not null]
  expires_at timestamp [not null]
  created_at timestamp
}

// ===== ATTENDANCE & TIME TRACKING =====

Table attendance_logs {
  id bigint [pk, increment]
  student_user_id bigint [not null, ref: > users.id]
  work_date date [not null]
  time_in time [not null]
  time_out time
  minutes_worked integer [default: 0]
  status varchar(50) [default: 'incomplete']
  ip_address varchar(45)
  latitude decimal(10,7)
  longitude decimal(10,7)
  is_recovery boolean [default: false]
  recovery_time_out time
  recovery_reason text
  recovery_status varchar(50)
  recovery_reviewed_by bigint [ref: > users.id]
  recovery_reviewed_at timestamp
  created_at timestamp
  updated_at timestamp
  
  indexes {
    (student_user_id, work_date)
  }
}

// ===== REPORTS & EVALUATIONS =====

Table weekly_reports {
  id bigint [pk, increment]
  student_user_id bigint [not null, ref: > users.id]
  supervisor_user_id bigint [ref: > users.id]
  coordinator_user_id bigint [ref: > users.id]
  week_number integer [not null]
  date_from date [not null]
  date_to date [not null]
  tasks_accomplished text [not null]
  status varchar(50) [default: 'submitted']
  submitted_at timestamp [not null]
  reviewed_at timestamp
  created_at timestamp
  updated_at timestamp
  
  indexes {
    (student_user_id, week_number)
  }
}

Table monthly_evaluations {
  id bigint [pk, increment]
  student_user_id bigint [not null, ref: > users.id]
  supervisor_user_id bigint [not null, ref: > users.id]
  coordinator_user_id bigint [ref: > users.id]
  evaluation_month integer [not null]
  evaluation_year integer [not null]
  work_quality integer [not null]
  work_quantity integer [not null]
  punctuality integer [not null]
  initiative integer [not null]
  cooperation integer [not null]
  judgment integer [not null]
  dependability integer [not null]
  learning_ability integer [not null]
  communication integer [not null]
  technical_skills integer [not null]
  total_rating decimal(3,2)
  supervisor_comments text
  status varchar(50) [default: 'submitted']
  submitted_at timestamp [not null]
  reviewed_at timestamp
  created_at timestamp
  updated_at timestamp
  
  indexes {
    (student_user_id, evaluation_month, evaluation_year)
  }
}

Table final_evaluations {
  id bigint [pk, increment]
  student_user_id bigint [not null, ref: > users.id]
  supervisor_user_id bigint [not null, ref: > users.id]
  coordinator_user_id bigint [ref: > users.id]
  student_id varchar(255) [not null]
  student_name varchar(255) [not null]
  company_name varchar(255) [not null]
  control_number varchar(100) [unique]
  work_quality integer [not null]
  quantity_of_work integer [not null]
  job_knowledge integer [not null]
  attendance_punctuality integer [not null]
  communication integer [not null]
  initiative integer [not null]
  judgment integer [not null]
  professionalism integer [not null]
  cooperation integer [not null]
  dependability integer [not null]
  total_rating decimal(3,2)
  overall_assessment text
  supervisor_comments text
  recommendations text
  status varchar(50) [default: 'submitted']
  submitted_at timestamp [not null]
  reviewed_at timestamp
  created_at timestamp
  updated_at timestamp
}

// ===== DOCUMENTS & SUBMISSIONS =====

Table document_requirements {
  id bigint [pk, increment]
  name varchar(255) [not null]
  description text
  type varchar(50) [not null]
  required boolean [default: true]
  allowed_extensions varchar(255) [default: 'pdf,docx']
  max_file_size_mb integer [default: 5]
  max_files integer [default: 1]
  display_order integer [default: 0]
  is_active boolean [default: true]
  created_at timestamp
  updated_at timestamp
}

Table student_document_submissions {
  id bigint [pk, increment]
  student_user_id bigint [not null, ref: > users.id]
  document_requirement_id bigint [not null, ref: > document_requirements.id]
  file_path varchar(255) [not null]
  original_filename varchar(255) [not null]
  file_size integer [not null]
  mime_type varchar(100) [not null]
  submission_notes text
  status varchar(50) [default: 'pending']
  reviewed_by bigint [ref: > users.id]
  review_notes text
  reviewed_at timestamp
  submitted_at timestamp [not null]
  created_at timestamp
  updated_at timestamp
}

Table resumes {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  profile_image_path varchar(255)
  full_name varchar(255) [not null]
  objective text
  education text
  skills text
  certifications text
  status varchar(50) [default: 'draft']
  submitted_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table application_letters {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  file_path varchar(255) [not null]
  status varchar(50) [default: 'draft']
  submitted_at timestamp
  created_at timestamp
  updated_at timestamp
}

// ===== ACCEPTANCE & PLACEMENT =====

Table acceptance_letters {
  id bigint [pk, increment]
  student_user_id bigint [not null, ref: > users.id]
  supervisor_user_id bigint [not null, ref: > users.id]
  company_id bigint [ref: > companies.id]
  student_name varchar(255) [not null]
  student_id varchar(255) [not null]
  supervisor_name varchar(255) [not null]
  company_name varchar(255) [not null]
  position varchar(255)
  department_division varchar(255)
  start_date date [not null]
  end_date date [not null]
  working_hours_from time [not null]
  working_hours_to time [not null]
  break_minutes integer [default: 60]
  days_of_week varchar(255) [not null]
  status varchar(50) [default: 'active']
  issued_at timestamp [not null]
  created_at timestamp
  updated_at timestamp
}

// ===== COMMUNICATION =====

Table notifications {
  id char(36) [pk]
  user_id bigint [not null, ref: > users.id]
  type varchar(255) [not null]
  data text [not null]
  read_at timestamp
  created_at timestamp
  
  indexes {
    (user_id)
    (user_id, read_at)
  }
}

Table messages {
  id bigint [pk, increment]
  sender_id bigint [not null, ref: > users.id]
  recipient_id bigint [not null, ref: > users.id]
  subject varchar(255) [not null]
  body text [not null]
  is_read boolean [default: false]
  read_at timestamp
  created_at timestamp
  updated_at timestamp
  
  indexes {
    (sender_id)
    (recipient_id)
  }
}

// ===== SYSTEM MANAGEMENT =====

Table audit_logs {
  id bigint [pk, increment]
  user_id bigint [ref: > users.id]
  action varchar(255) [not null]
  model_type varchar(255)
  model_id bigint
  changes text
  ip_address varchar(45)
  user_agent text
  created_at timestamp
}

Table password_resets {
  email varchar(255) [not null]
  token varchar(255) [not null]
  created_at timestamp
  
  indexes {
    (email)
  }
}

Table failed_jobs {
  id bigint [pk, increment]
  uuid varchar(255) [unique, not null]
  connection text [not null]
  queue text [not null]
  payload text [not null]
  exception text [not null]
  failed_at timestamp [default: `CURRENT_TIMESTAMP`]
}
